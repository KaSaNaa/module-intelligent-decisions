  "version": "1.0.0",
  "description": "IDSS Fleet Decision Intelligence Engine & Module for Intelligent Decisions",
  "main": "src/index.jsx",
  "scripts": {
    "start": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev": "webpack serve --mode development",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "webpack serve --mode development",
    "build": "npm --prefix server run build && webpack --mode production",
    "build:client": "webpack --mode production",
    "test:server": "npm --prefix server test",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "module-federation",
    "module_intelligent_decisions",
    "idss"
  ],
  "author": "",
